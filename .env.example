# Development only. The process reads environment variables, not this file.
TAGIHNET_DEBUG=1
TAGIHNET_SIMULATION=1
TAGIHNET_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional trusted origin for new Snap checkout return URLs; no path/query/fragment.
# Also add the public hostname to TAGIHNET_ALLOWED_HOSTS. HTTPS required outside loopback development.
# TAGIHNET_PUBLIC_ORIGIN=https://billing.example.invalid
# Set a unique random secret and TAGIHNET_DEBUG=0 behind HTTPS for a deployment.
# TAGIHNET_SECRET_KEY=
# Separate Fernet key. Generate with cryptography.fernet.Fernet.generate_key(); never commit.
# TAGIHNET_MFA_KEY=
# TAGIHNET_SECURE_COOKIES=1
# TAGIHNET_DATA_DIR=/var/lib/tagihnet
# TAGIHNET_EMAIL_HOST=
# TAGIHNET_EMAIL_USER=
# TAGIHNET_EMAIL_PASSWORD=
# SQLite is the default. Install requirements-postgres.txt before selecting PostgreSQL.
# TAGIHNET_DB_ENGINE=postgresql
# TAGIHNET_DB_HOST=db.example.invalid
# TAGIHNET_DB_PORT=5432
# TAGIHNET_DB_NAME=tagihnet
# TAGIHNET_DB_USER=tagihnet_app
# Choose one password source, never both. Do not commit its value or file.
# TAGIHNET_DB_PASSWORD=
# TAGIHNET_DB_PASSWORD_FILE=/private/tagihnet-db-password
# TAGIHNET_DB_SSLMODE=verify-full
# TAGIHNET_DB_SSLROOTCERT=/private/postgresql-ca.pem
# Optional private JSON keyed by tenant ID; see docs/PAYMENT-GATEWAY.md.
# Supply sandbox merchant_id/server_key through a private process environment; never commit values.
# TAGIHNET_MIDTRANS_SANDBOX_ACCOUNT_KEYS=
